{"action": "require-environment", "name": "production"}
{"action": "open", "path": "/?player_name=LeBron+James&season_filter=2025-26&game_filter=5"}
{"action": "assert-response", "method": "GET", "path": "/api/games/game_logs", "query": {"player_name": "LeBron James", "season_filter": "2025-26", "game_filter": "5"}, "status": 200}
{"action": "assert", "target": {"selector": "[data-testid=\"filter-panel\"]"}}
{"action": "assert", "target": {"role": "button", "name": "Remove last"}}
{"action": "snapshot"}
{"action": "proof", "name": "filter-panel-production-desktop"}
{"action": "viewport", "name": "phone"}
{"action": "click", "target": {"role": "button", "name": "+ Last N"}}
{"action": "click", "target": {"role": "button", "name": "10"}}
{"action": "click", "target": {"role": "button", "name": "Done"}}
{"action": "click", "target": {"role": "button", "name": "Apply 1 change"}}
{"action": "assert-response", "method": "GET", "path": "/api/games/game_logs", "query": {"player_name": "LeBron James", "season_filter": "2025-26", "game_filter": "10"}, "status": 200}
{"action": "assert", "target": {"within": {"selector": "[data-testid=\"filter-panel\"]"}, "text": "10 games"}}
{"action": "assert-layout"}
{"action": "proof", "name": "filter-panel-production-phone-applied"}
{"action": "cleanup"}
