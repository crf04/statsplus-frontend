{"action": "assert", "target": {"within": {"selector": "[data-testid=\"filter-panel\"]"}, "text": "5 of 60 games match"}}
{"action": "viewport", "name": "phone"}
{"action": "click", "target": {"role": "button", "name": "+ Last N"}}
{"action": "click", "target": {"role": "button", "name": "15"}}
{"action": "click", "target": {"role": "button", "name": "Done"}}
{"action": "click", "target": {"role": "button", "name": "Apply 1 change"}}
{"action": "assert-response", "method": "GET", "path": "/api/games/game_logs", "query": {"player_name": "LeBron James", "season_filter": "2025-26", "game_filter": "15"}, "status": 200}
{"action": "assert", "target": {"within": {"selector": "[data-testid=\"filter-panel\"]"}, "text": "15 games"}}
{"action": "assert", "target": {"within": {"selector": "[data-testid=\"filter-panel\"]"}, "text": "15 of 60 games match"}}
{"action": "assert-layout"}
