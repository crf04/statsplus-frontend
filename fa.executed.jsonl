{"action": "click", "target": {"role": "combobox", "name": "Defender"}}
{"action": "press", "key": "P"}
{"action": "press", "key": "Enter"}
{"action": "assert", "target": {"text": "Backtest up to date."}}
{"action": "assert-response", "method": "POST", "path": "/api/user/targets/preview", "query": {}, "status": 200}
{"action": "proof", "name": "fa1-lab-defender-2025-26-desktop"}
{"action": "click", "target": {"within": {"role": "group", "name": "Backtest season"}, "role": "button", "name": "2024-25"}}
{"action": "assert", "target": {"text": "Backtest not updated."}}
{"action": "assert-response", "method": "POST", "path": "/api/user/targets/preview", "query": {}, "status": 503}
