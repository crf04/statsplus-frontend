{
  "name": "nba-game-logs",
  "version": "0.1.0",
  "description": "React frontend for NBA game logs analysis with interactive filtering, natural language queries, and chart-based visualizations.",
  "author": "Chris Fu",
  "license": "MIT",
  "homepage": "https://courtai.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/crf04/statsplus-frontend.git"
  },
  "bugs": {
    "url": "https://github.com/crf04/statsplus-frontend/issues"
  },
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=22.12.0"
  },
  "keywords": [
    "react",
    "nba",
    "basketball",
    "analytics",
    "data-visualization",
    "chartjs",
    "firebase",
    "natural-language-query"
  ],
  "dependencies": {
    "axios": "^1.19.0",
    "bootstrap": "^5.3.3",
    "chart.js": "^4.4.3",
    "chartjs-plugin-annotation": "^3.0.1",
    "firebase": "^12.1.0",
    "lucide-react": "^0.408.0",
    "react": "^18.3.1",
    "react-bootstrap": "^2.10.2",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18.3.1",
    "react-slider": "^2.0.6",
    "recharts": "^2.12.7"
  },
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:ci": "jest --ci --runInBand",
    "lint": "eslint .",
    "format:check": "prettier --check package.json README.md index.html src vite.config.mjs babel.config.cjs eslint.config.mjs postcss.config.js tailwind.config.js .github/workflows/ci.yml .prettierrc.json",
    "format": "prettier --write package.json README.md index.html src vite.config.mjs babel.config.cjs eslint.config.mjs postcss.config.js tailwind.config.js .github/workflows/ci.yml .prettierrc.json"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "setupFilesAfterEnv": [
      "<rootDir>/src/setupTests.js"
    ],
    "moduleNameMapper": {
      "\\.(css)$": "identity-obj-proxy"
    },
    "transform": {
      "^.+\\.(js|jsx)$": "babel-jest"
    }
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "autoprefixer": "^10.4.19",
    "@eslint/js": "^9.39.5",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "@vitejs/plugin-react": "^5.2.0",
    "babel-jest": "^30.4.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.9.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "postcss": "^8.4.39",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.5",
    "vite": "^7.3.6"
  }
}
